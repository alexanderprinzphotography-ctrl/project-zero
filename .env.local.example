# Supabase-Projekt (EU-Region) — Werte aus dem Supabase-Dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://yquciapgfnlianxumnpx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_sJGAfQfZHrC2PFCc8yVh7A_jYjaw71I"

# Fuer die Integrationstests (tests/integration) UND fuer den Stripe-Webhook
# (MS 9a, umgeht RLS bewusst, da Stripe keine Supabase-Session hat) - niemals
# NEXT_PUBLIC_, niemals im Client-Bundle, niemals committen. Ohne diesen Wert
# werden die RLS-Isolationstests uebersprungen (siehe docs/MS1a_manueller_test.md)
# und der Stripe-Webhook schlaegt fehl.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic-API-Key fuer den KI-Angebotsentwurf (MS 8c) - ausschliesslich
# serverseitig verwendet (niemals NEXT_PUBLIC_, niemals im Client-Bundle).
# Ohne diesen Wert schlaegt "Angebot mit KI erstellen" mit einer Fehlermeldung fehl.
ANTHROPIC_API_KEY=

# Stripe (MS 9a, Test-Modus) - Secret Key und Webhook-Signing-Secret nur
# serverseitig, niemals NEXT_PUBLIC_. Die 4 Price-IDs kommen aus den beiden
# Produkten "Basic"/"Pro" (je monatlich + jaehrlich) im Stripe-Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
